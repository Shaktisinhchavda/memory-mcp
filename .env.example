# ============================================
# Personal MCP Ecosystem — Environment Config
# ============================================
# Copy this file to .env and adjust values.
# All paths are relative — works on Windows, macOS, and Linux.

# --- Paths ---
DATA_DIR=./data
NOTES_DIR=./data/notes
FILES_DIR=./data/files

# --- Vector Store ---
CHROMA_DB_PATH=./.chroma
# Embedding model (runs 100% locally via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Event Logger ---
EVENTS_DB_PATH=./events.db

# --- Neo4j Knowledge Graph ---
# Only needed if using Phase 3 (docker compose up -d)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memory-mcp-2026

# --- MCP Server ---
MCP_SERVER_NAME=memory-mcp
# Transport: stdio (for Claude Desktop) or sse (for HTTP clients)
MCP_TRANSPORT=stdio
